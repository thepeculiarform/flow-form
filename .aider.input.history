# 2025-02-28 13:20:41.714988
+def create_sine_wave_on_sphere(sphere_radius=10.0, num_points=100, 
+                              latitude_cycles=2, amplitude=0.5, 
+                              start_longitude=0, end_longitude=math.pi*2):
+    """
+    Creates a sine wave curve on the surface of a sphere.
+    
+    Args:
+        sphere_radius: Radius of the sphere
+        num_points: Number of points to use for the curve
+        latitude_cycles: Number of sine wave cycles around the sphere
+        amplitude: Amplitude of the sine wave in radians (controls height)
+        start_longitude: Starting longitude angle in radians
+        end_longitude: Ending longitude angle in radians
+    
+    Returns:
+        A curve object representing the sine wave on the sphere
+    """
+    # Create the sphere
+    sphere = rg.Sphere(rg.Point3d.Origin, sphere_radius)
+    
+    # Create points for the sine wave
+    points = []
+    
+    for i in range(num_points):
+        # Calculate longitude (position around the sphere)
+        t = float(i) / (num_points - 1)
+        longitude = start_longitude + t * (end_longitude - start_longitude)
+        
+        # Calculate latitude with sine wave variation
+        base_latitude = 0  # Equator
+        latitude = base_latitude + amplitude * math.sin(latitude_cycles * longitude)
+        
+        # Convert spherical coordinates to Cartesian
+        x = sphere_radius * math.cos(latitude) * math.cos(longitude)
+        y = sphere_radius * math.cos(latitude) * math.sin(longitude)
+        z = sphere_radius * math.sin(latitude)
+        
+        point = rg.Point3d(x, y, z)
+        points.append(point)
+    
+    # Create an interpolated curve through the points
+    curve = rg.Curve.CreateInterpolatedCurve(points, 3)
+    
+    # Add objects to Rhino document
+    # if sc.doc:
+    #     # Add sphere
+    #     sphere_id = sc.doc.Objects.AddSphere(sphere)
+        
+    #     # Add curve
+    #     curve_id = sc.doc.Objects.AddCurve(curve)
+        
+    #     sc.doc.Views.Redraw()
+        
+    #     return sphere_id, curve_id
+    
+    return sphere, curve

